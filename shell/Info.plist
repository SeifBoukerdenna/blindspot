<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. The Makefile substitutes @BUNDLE_ID@ and @VERSION@ into build/. -->
<plist version="1.0">
<dict>
	<!-- The GitHub repository whose latest release Settings → Status can install (Updater.swift). -->
	<key>BlindspotReleaseRepository</key>
	<string>@RELEASE_REPO@</string>
	<key>CFBundleExecutable</key>
	<string>blindspot</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleName</key>
	<string>Blindspot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Background agent: no Dock icon, no menu bar. Showing the panel must not
	     make blindspot the active app, and an agent cannot become one by accident. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Read the selected Finder item, browser URL, or terminal session when you use a contextual command. Data stays on this Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Show today's and tomorrow's events and their meeting links when you ask for your schedule. Calendar data stays on this Mac.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Show today's and tomorrow's events and their meeting links when you ask for your schedule. Calendar data stays on this Mac.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
